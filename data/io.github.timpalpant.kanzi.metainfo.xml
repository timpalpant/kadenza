<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.timpalpant.kanzi</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Kanzi</name>
  <summary>A native Apple Music client for KDE Plasma</summary>
  <description>
    <p>Kanzi brings an adaptive, desktop-integrated Kirigami interface for browsing and listening to Apple Music on KDE Plasma.</p>
    <p>Browse your library, search the Apple Music catalog, manage a playback queue, and control playback from a native Qt application. Licensed playback runs through an isolated MusicKit and Widevine sidecar.</p>
  </description>
  <launchable type="desktop-id">io.github.timpalpant.kanzi.desktop</launchable>
  <provides><binary>kanzi</binary></provides>
  <url type="homepage">https://timpalpant.github.io/kanzi/</url>
  <url type="bugtracker">https://github.com/timpalpant/kanzi/issues</url>
  <developer id="io.github.timpalpant"><name>Timothy Palpant</name></developer>
  <content_rating type="oars-1.1"/>
  <!-- Tints taken from the application icon; Discover and GNOME Software use
       them behind the app header. -->
  <branding>
    <color type="primary" scheme_preference="light">#ffd7c6</color>
    <color type="primary" scheme_preference="dark">#5c1136</color>
  </branding>
