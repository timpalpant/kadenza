# Maintainer: Tim Palpant <tim@palpant.us>

pkgname=kanzi
pkgver=0.1.1
pkgrel=1
pkgdesc="Native Apple Music client for KDE Plasma"
arch=('x86_64')
url="https://github.com/timpalpant/kanzi"
license=('GPL-3.0-or-later')
# electron43-castlab-bin is a Widevine-enabled Electron build, required for
# DRM-protected playback. A vanilla Electron has no CDM and would silently
# fall back to 30-second previews instead of failing to build. Keep this in
# lockstep with sidecar/package.json's pinned Electron version and with
# kSystemElectron in src/player/playercontroller.cpp -- Kanzi looks for this
# exact package name on PATH when nothing is bundled alongside it.
# qqc2-desktop-style is not merely cosmetic: main.cpp always selects the
# "org.kde.desktop" QQC2 style unless QT_QUICK_CONTROLS_STYLE is already set,
# and without it the QML engine refuses to load at all -- confirmed by
# installing the .deb equivalent of this package in a bare container with
# nothing pre-satisfied by a desktop environment.
depends=('qt6-base' 'qt6-declarative' 'kirigami' 'ki18n' 'kcoreaddons' 'kconfig' 'knotifications' 'kglobalaccel' 'glibc' 'electron43-castlab-bin' 'qqc2-desktop-style')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('REPLACE_WITH_RELEASE_SHA256')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=ON
  cmake --build build
}

check() { ctest --test-dir build --output-on-failure --no-tests=error; }

package() {
  DESTDIR="$pkgdir" cmake --install build
}
